# Copy to .env (git-ignored). Only EXPO_PUBLIC_* vars reach the app, and they
# are bundled into the client, so never put secrets here.

# Backend base URL. Leave empty to auto-use <your laptop LAN IP>:4000 in dev
# (works for Expo Go on the same Wi-Fi). Set to the tunnel / Render URL otherwise.
EXPO_PUBLIC_API_URL=

# Auth0 (non-secret; defaults baked in src/config.ts)
EXPO_PUBLIC_AUTH0_DOMAIN=dev-qfcvf4rkm3dp8xsh.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=qQweRCxviMmTL4nsKygCt8Try2jLvQJL
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.finni.app

# demo = no login, the app makes a device id and the API runs AUTH_MODE=demo. auth0 = real login.
EXPO_PUBLIC_AUTH_MODE=demo
# First name Finn uses in demo mode.
EXPO_PUBLIC_DEMO_NAME=
