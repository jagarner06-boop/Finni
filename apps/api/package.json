{
  "name": "@finni/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:merchants": "tsx --env-file=.env scripts/seed-merchants.ts",
    "spike:nessie": "tsx --env-file=.env scripts/spike-nessie.ts",
    "spike:gemini": "tsx --env-file=.env scripts/spike-gemini.ts",
    "demo:reset": "tsx --env-file=.env scripts/demo-reset.ts",
    "smoke:seed": "tsx --env-file=.env scripts/smoke-seed.ts",
    "smoke:actions": "tsx --env-file=.env scripts/smoke-actions.ts",
    "smoke:charts": "tsx --env-file=.env scripts/smoke-charts.ts",
    "smoke:agent": "tsx --env-file=.env scripts/smoke-agent.ts",
    "test": "vitest run",
    "smoke:live": "tsx --env-file=.env scripts/smoke-live.ts",
    "smoke:consistency": "tsx --env-file=.env scripts/smoke-consistency.ts",
    "smoke:race": "tsx --env-file=.env scripts/smoke-race.ts",
    "smoke:cashflow": "tsx --env-file=.env scripts/smoke-cashflow.ts",
    "demo:short": "tsx --env-file=.env scripts/demo-short.ts",
    "db:migrate:cashflow": "node --env-file=.env --import tsx scripts/migrate-cashflow.ts",
    "diagnose:gemini": "node --env-file=.env --import tsx scripts/diagnose-gemini.ts"
  },
  "dependencies": {
    "@finni/shared": "*",
    "@google/genai": "^2.30.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-oauth2-jwt-bearer": "^1.11.0",
    "jose": "^4.15.9",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
