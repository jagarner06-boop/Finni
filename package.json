{
  "name": "finni",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "npm run dev -w @finni/api",
    "mobile": "npm run start -w @finni/mobile",
    "mobile:web": "npm run web -w @finni/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "react-native-gesture-handler": "~2.32.0",
    "react": "19.2.3"
  }
}
